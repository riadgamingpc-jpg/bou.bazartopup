<script>

let selectedPackage="";
let selectedPrice="";

function selectPackage(name,price){

selectedPackage=name;
selectedPrice=price;

alert(
"Selected Package: "+name+
"\nPrice: "+price+" TK"+
"\n\nSend Money:\n01851634841 (bKash / Nagad)"
);

}

function submitOrder(){

let uid=document.getElementById("uid").value;

if(uid==""){
alert("UID দিন");
return;
}

alert(
"Order Submitted ✅"+
"\nUID: "+uid+
"\nPackage: "+selectedPackage+
"\nPrice: "+selectedPrice+" TK"
);

}

function whatsappOrder(){

let uid=document.getElementById("uid").value;

let msg="Order\nUID: "+uid+"\nPackage: "+selectedPackage+"\nPrice: "+selectedPrice+" TK";

window.open("https://wa.me/8801851634841?text="+encodeURIComponent(msg));

}

</script>

